# Fichier .env de production : a copier dans /opt/lexia/.env sur le serveur (chmod 600).
# Ne jamais le commiter.

# Chiffrement des secrets gardes en base (cles de double authentification, codes de secours).
# Genere par deploy/publier.sh s'il manque ; a sauvegarder avec cette configuration.
# En cas de perte : python -m api.admin desactiver2fa <email> debloque un compte.
CLE_SECRETS=

# Verification de l'adresse e-mail a l'inscription (resend.com). Vide = verification desactivee.
# L'expediteur doit appartenir a un domaine verifie dans Resend (enregistrements DNS).
RESEND_API_KEY=
RESEND_EXPEDITEUR=Lexia <verification@axionstudio.fr>

# Gemini (Google AI Studio). Niveau payant conseille : le gratuit plafonne a 20 requetes/jour sur gemini-3.5-flash.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest,gemini-3.8-flash
# Niveau payant (D83) : la meme cle, une fois la facturation activee sur son projet dans AI Studio ; mettre
# GEMINI_NIVEAU_PAYANT=1 (plus bas). Garder gemini-3.5-flash-lite : gemini-3.5-flash n'est plus sur la grille
# tarifaire de Google (verifie le 2026-11-17). Prix du niveau payant a cette date, en dollars par million de jetons
# (entree, sortie reflexion comprise) : gemini-3.5-flash-lite 0,30 / 2,50 ; gemini-3.8-flash 0,75 / 3,75 jusqu'au
# 2026-12-31 puis 1,50 / 7,50. gemini-flash-lite-latest est un alias absent de la grille.
# Cout par question : python eval/cout.py <logs> --prix gemini-3.5-flash-lite=0.30,2.50 --prix gemini-3.8-flash=0.75,3.75
# Secours quand tous les modeles Gemini echouent (cle sur console.groq.com, vide = pas de secours)
# Donnees stockees aux Etats-Unis : activer « Zero Data Retention » dans la console Groq si renseignee (D51).
GROQ_API_KEY=
GROQ_MODELS=qwen/qwen3.8-27b,openai/gpt-oss-120b
# Avec Groq : un seul tour de modeles Gemini, et ce temps total au plus avant de passer a Groq
BUDGET_AVANT_SECOURS_SECONDES=35
# Disjoncteur : apres N echecs de Gemini d'affilee, Groq seul pendant cette pause
DISJONCTEUR_SEUIL=3
DISJONCTEUR_PAUSE_SECONDES=300
GEMINI_THINKING_LEVEL=low
LLM_TIMEOUT_SECONDS=30

# Embeddings et reclassement : modeles open source executes sur le serveur
EMBED_PROVIDER=local
EMBED_MODEL=intfloat/multilingual-e5-base
RERANK_MODEL=antoinelouis/crossencoder-camembert-base-mmarcoFR

# Reformulation de la question (vide = desactive ; double les appels Gemini)
QUERY_EXPANSION_MODEL=gemini-3.5-flash-lite
QUERY_EXPANSION_FALLBACK_MODELS=gemini-flash-lite-latest
QUERY_EXPANSION_TIMEOUT=6

# Comptes et formules (base SQLite des comptes : /opt/lexia/donnees/lexia.db, jamais ecrasee par publier.sh)
COMPTES_ACTIFS=1
APP_DB=/opt/lexia/donnees/lexia.db
# Comptes administrateurs (tableau de bord /admin), separes par des virgules
ADMIN_EMAILS=
# Adresse affichee sur la page Tarifs pour demander une formule payante (vide = "Bientot disponible")
CONTACT_EMAIL=

# Pages legales (mentions legales, CGU, confidentialite). Vide = « a completer » affiche sur le site.
LEGAL_EDITEUR=
LEGAL_STATUT=
LEGAL_ADRESSE=
LEGAL_SIREN=
LEGAL_DIRECTEUR=
LEGAL_TELEPHONE=
LEGAL_MEDIATEUR=
# Telephone de l'hebergeur (obligatoire, LCEN art. 1-1 4°) : a demander au support Hostinger
LEGAL_HEBERGEUR_TELEPHONE=
# Mention TVA affichee avec les prix, ex. : TVA non applicable, art. 293 B du CGI
LEGAL_TVA=
# Mettre 1 une fois la cle Gemini passee au niveau payant : les conditions Gemini n'autorisent que les
# services payants pour une application proposee a des utilisateurs dans l'Espace economique europeen.
GEMINI_NIVEAU_PAYANT=0

# Paiement en ligne par Stripe Checkout (D86). Vide = formules activees a la main (python -m api.admin formule).
# Actif seulement avec les deux valeurs et URL_PUBLIQUE. Cle secrete : tableau de bord Stripe, Developpeurs,
# Cles API (sk_live_..., ou sk_test_... pour les essais). Secret du webhook (whsec_...) : endpoint
# https://<domaine>/api/paiement/webhook, evenements checkout.session.completed,
# checkout.session.async_payment_succeeded, checkout.session.async_payment_failed, checkout.session.expired,
# charge.refunded et charge.dispute.created (docs/avant-la-vente.md, section 4).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Garde-fous
MAX_QUESTION_CHARS=2000
# Questions par minute, par etudiant connecte (par adresse IP sans session)
RATE_LIMIT_PER_MINUTE=10
# Questions et questionnaires traites en meme temps (sur 40 fils)
APPELS_MODELE_SIMULTANES=20
# Comptes crees par adresse IP sur 24 h (0 = sans limite). A relever pour une inscription en salle (meme wifi).
INSCRIPTIONS_PAR_IP_JOUR=20

# Meme domaine pour le front et l'API : pas d'origine externe a autoriser
CORS_ORIGINS=

# Adresse publique du site : base des liens envoyes par e-mail (obligatoire avec RESEND_API_KEY).
URL_PUBLIQUE=https://lexia.mondomaine.fr

# Arrets recents de la Cour de cassation par l'API Judilibre (D113) : cle « KeyId » de l'application PISTE.
# Vide : Judilibre desactive, l'index garde l'archive DILA seule. Demarches : docs/jurisprudence-recente.md, partie 5.
JUDILIBRE_KEY_ID=
