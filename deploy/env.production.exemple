# Fichier .env de production : a copier dans /opt/lexia/.env sur le serveur (chmod 600).
# Ne jamais le commiter.

# Gemini (Google AI Studio). Niveau payant conseille : le gratuit plafonne a 20 requetes/jour sur gemini-3.5-flash.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest,gemini-3.8-flash
GEMINI_THINKING_LEVEL=low
LLM_TIMEOUT_SECONDS=30

# Embeddings et reclassement : modeles open source executes sur le serveur
EMBED_PROVIDER=local
EMBED_MODEL=intfloat/multilingual-e5-base
RERANK_MODEL=antoinelouis/crossencoder-camembert-base-mmarcoFR

# Reformulation de la question (vide = desactive ; double les appels Gemini)
QUERY_EXPANSION_MODEL=gemini-3.5-flash-lite
QUERY_EXPANSION_FALLBACK_MODELS=gemini-flash-lite-latest
QUERY_EXPANSION_TIMEOUT=6

# Recherche : index local SQLite envoye depuis la machine de developpement (data/index)
# Variante PostgreSQL + pgvector : RETRIEVER=postgres et DATABASE_URL=postgresql://...
RETRIEVER=local
DATABASE_URL=

# Comptes et formules (base SQLite des comptes : /opt/lexia/donnees/lexia.db, jamais ecrasee par publier.sh)
COMPTES_ACTIFS=1
APP_DB=/opt/lexia/donnees/lexia.db
# Comptes administrateurs (tableau de bord /admin), separes par des virgules
ADMIN_EMAILS=
# Adresse affichee sur la page Tarifs pour demander une formule payante (vide = "Bientot disponible")
CONTACT_EMAIL=

# Garde-fous
MAX_QUESTION_CHARS=2000
RATE_LIMIT_PER_MINUTE=10

# Meme domaine pour le front et l'API : pas d'origine externe a autoriser
CORS_ORIGINS=
