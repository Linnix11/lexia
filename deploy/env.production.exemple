# Fichier .env de production : a copier dans /opt/lexia/.env sur le serveur (chmod 600).
# Ne jamais le commiter.

# Gemini (Google AI Studio). Niveau payant conseille : le gratuit plafonne a 20 requetes/jour sur gemini-3.5-flash.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest,gemini-3.8-flash
# Cle au niveau payant (GEMINI_NIVEAU_PAYANT=1) : repasser la generation sur le modele complet (D29 levee) :
#   GEMINI_MODEL=gemini-3.5-flash
#   GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-flash-lite-latest
# puis mesurer le cout par question : python eval/cout.py <logs> --prix MODELE=ENTREE,SORTIE
# Secours quand tous les modeles Gemini echouent (cle sur console.groq.com, vide = pas de secours)
# Donnees stockees aux Etats-Unis : activer « Zero Data Retention » dans la console Groq si renseignee (D51).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Avec Groq : un seul tour de modeles Gemini, et ce temps total au plus avant de passer a Groq
BUDGET_AVANT_SECOURS_SECONDES=35
# Disjoncteur : apres N echecs de Gemini d'affilee, Groq seul pendant cette pause
DISJONCTEUR_SEUIL=3
DISJONCTEUR_PAUSE_SECONDES=300
GEMINI_THINKING_LEVEL=low
LLM_TIMEOUT_SECONDS=30

# Embeddings et reclassement : modeles open source executes sur le serveur
EMBED_PROVIDER=local
EMBED_MODEL=intfloat/multilingual-e5-base
RERANK_MODEL=antoinelouis/crossencoder-camembert-base-mmarcoFR

# Reformulation de la question (vide = desactive ; double les appels Gemini)
QUERY_EXPANSION_MODEL=gemini-3.5-flash-lite
QUERY_EXPANSION_FALLBACK_MODELS=gemini-flash-lite-latest
QUERY_EXPANSION_TIMEOUT=6

# Comptes et formules (base SQLite des comptes : /opt/lexia/donnees/lexia.db, jamais ecrasee par publier.sh)
COMPTES_ACTIFS=1
APP_DB=/opt/lexia/donnees/lexia.db
# Comptes administrateurs (tableau de bord /admin), separes par des virgules
ADMIN_EMAILS=
# Adresse affichee sur la page Tarifs pour demander une formule payante (vide = "Bientot disponible")
CONTACT_EMAIL=

# Pages legales (mentions legales, CGU, confidentialite). Vide = « a completer » affiche sur le site.
LEGAL_EDITEUR=
LEGAL_STATUT=
LEGAL_ADRESSE=
LEGAL_SIREN=
LEGAL_DIRECTEUR=
LEGAL_TELEPHONE=
LEGAL_MEDIATEUR=
# Telephone de l'hebergeur (obligatoire, LCEN art. 1-1 4°) : a demander au support Hostinger
LEGAL_HEBERGEUR_TELEPHONE=
# Mention TVA affichee avec les prix, ex. : TVA non applicable, art. 293 B du CGI
LEGAL_TVA=
# Mettre 1 une fois la cle Gemini passee au niveau payant : les conditions Gemini n'autorisent que les
# services payants pour une application proposee a des utilisateurs dans l'Espace economique europeen.
GEMINI_NIVEAU_PAYANT=0

# Garde-fous
MAX_QUESTION_CHARS=2000
RATE_LIMIT_PER_MINUTE=10
# Comptes crees par adresse IP sur 24 h (0 = sans limite). A relever pour une inscription en salle (meme wifi).
INSCRIPTIONS_PAR_IP_JOUR=20

# Meme domaine pour le front et l'API : pas d'origine externe a autoriser
CORS_ORIGINS=
