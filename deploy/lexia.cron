# Sauvegarde de la base des comptes et purge des journaux (voir deploy/sauvegarder_comptes.sh)
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# En tant que lexia, jamais root : les fichiers de /opt/lexia sont modifiables par le service.
15 3 * * * lexia /opt/lexia/deploy/sauvegarder_comptes.sh >> /opt/lexia/logs/sauvegarde.log 2>&1
