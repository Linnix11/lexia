# Service systemd de Lexia (API + panel etudiant).
# Installe par deploy/installer_serveur.sh dans /etc/systemd/system/lexia.service
[Unit]
Description=Lexia - assistant d'etude en droit (API + panel)
After=network-online.target
Wants=network-online.target

[Service]
User=lexia
Group=lexia
WorkingDirectory=/opt/lexia
EnvironmentFile=/opt/lexia/.env
Environment=HF_HOME=/opt/lexia/.cache/huggingface
Environment=TOKENIZERS_PARALLELISM=false
# Modeles lus dans le cache, sans interroger Hugging Face : un redemarrage ne depend plus de leur site
# (audit du 2026-11-18, D5). Nouveau serveur : HF_HUB_OFFLINE=0 dans .env pour le premier lancement
# (le .env l'emporte sur cette ligne), puis le retirer.
Environment=HF_HUB_OFFLINE=1
# Un seul processus : les modeles (embeddings + reclassement, ~2 Go de RAM) ne sont charges qu'une fois.
ExecStart=/opt/lexia/.venv/bin/uvicorn api.serveur:app --host 127.0.0.1 --port 8000 --workers 1 --proxy-headers --forwarded-allow-ips 127.0.0.1
# Le premier demarrage (HF_HUB_OFFLINE=0) telecharge les modeles (~1,6 Go) : laisser le temps
TimeoutStartSec=600
Restart=on-failure
RestartSec=5
# Durcissement
NoNewPrivileges=true
# Fichiers crees par le service (base, journal WAL, journaux techniques) lisibles par lexia seul : ils etaient
# en 644 (audit de la base du 2026-11-18, D99).
UMask=0077
PrivateTmp=true
# strict : tout le disque en lecture seule pour le service, sauf les trois dossiers ci-dessous. Avec « full »,
# /opt restait inscriptible : une faille dans la lecture d'un fichier depose pouvait reecrire le code
# (api/, .venv) et survivre au redemarrage (audit du 2026-11-16, point 15). pip tourne hors du service.
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/lexia/logs /opt/lexia/.cache /opt/lexia/donnees
# Suite du durcissement (audit du 2026-11-23, B4). A verifier sur le serveur : systemd-analyze security lexia.
# Pas de MemoryDenyWriteExecute ni de SystemCallFilter sans essai (PyTorch, tesseract).
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
RemoveIPC=true
# Ecoute locale, appels HTTPS sortants (Gemini, Groq, Resend, DILA) ; AF_NETLINK pour getaddrinfo de la glibc.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
# Modeles (~2 Go) et deux OCR simultanes : au-dela, le service est freine puis arrete et relance par systemd,
# au lieu de laisser l'OOM killer du noyau choisir un autre processus (nginx, sshd). En pourcentage de la
# memoire du VPS (8 Go conseilles, deploy/DEPLOIEMENT.md).
MemoryHigh=65%
MemoryMax=75%
# Un lecteur de fichier (OCR) tue par manque de memoire ne doit pas arreter l'API : seul l'arret du processus
# principal fait relancer le service (Restart=on-failure).
OOMPolicy=continue
TasksMax=512
# Dates (journaux, date du jour par defaut) a l'heure de Paris, quel que soit le fuseau du VPS (C4). Le code
# calcule deja l'etat « en vigueur » a l'heure de Paris (ingest.env.aujourdhui_paris).
Environment=TZ=Europe/Paris

[Install]
WantedBy=multi-user.target
