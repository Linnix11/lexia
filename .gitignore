# Secrets
.env
.env.*
!.env.example

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/

# Donnees telechargees (regenerables via ingest/run.py)
data/raw/

# Divers
.DS_Store
node_modules/

# Passages volumineux regeneres par ingest/run.py (seule la Constitution est versionnee)
data/passages/*.jsonl
!data/passages/constitution_1958.jsonl
data/passages/*.tmp

# Cache d'embeddings (regenere par ingest/embed.py)
data/embeddings/

# Index local de recherche (regenere par ingest/build_index.py)
data/index/

# Journaux de l'API
logs/

# Journaux d'execution de l'evaluation (les resultats .jsonl/.md/.csv sont versionnes)
eval/resultats/*.log

# Base des comptes (donnees personnelles : jamais versionnee)
donnees/

# Configuration locale des apercus
.claude/

# Version ecrite par deploy/publier.sh
VERSION
