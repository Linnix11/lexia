# Copier en .env (jamais commite) et remplir cote serveur uniquement.

# Gemini API Developer (Google AI Studio)
GEMINI_API_KEY=
# Modele de generation principal puis modeles de secours (429/503/delai depasse)
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest,gemini-3.8-flash
# Cle au niveau payant (GEMINI_NIVEAU_PAYANT=1) : repasser la generation sur le modele complet (D29 levee) :
#   GEMINI_MODEL=gemini-3.5-flash
#   GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-flash-lite-latest
# puis mesurer le cout par question : python eval/cout.py <logs> --prix MODELE=ENTREE,SORTIE
# Secours quand tous les modeles Gemini echouent (cle sur console.groq.com, vide = pas de secours)
# Donnees stockees aux Etats-Unis : activer « Zero Data Retention » dans la console Groq si renseignee (D51).
GROQ_API_KEY=
GROQ_MODELS=qwen/qwen3.8-27b,openai/gpt-oss-120b
# Avec Groq : un seul tour de modeles Gemini, et ce temps total au plus avant de passer a Groq
BUDGET_AVANT_SECOURS_SECONDES=35
# Disjoncteur : apres N echecs de Gemini d'affilee, Groq seul pendant cette pause
DISJONCTEUR_SEUIL=3
DISJONCTEUR_PAUSE_SECONDES=300
GEMINI_THINKING_LEVEL=low
LLM_TIMEOUT_SECONDS=30

# Embeddings : local (modele open source, sans quota) ou gemini (1 000 par jour en gratuit)
EMBED_PROVIDER=local
EMBED_MODEL=intfloat/multilingual-e5-base

# Recherche : reformulation de la question par un modele rapide (vide = desactive)
QUERY_EXPANSION_MODEL=gemini-3.5-flash-lite
QUERY_EXPANSION_FALLBACK_MODELS=gemini-flash-lite-latest
QUERY_EXPANSION_TIMEOUT=6
# Reclassement des candidats par un cross-encoder local (vide = desactive)
RERANK_MODEL=antoinelouis/crossencoder-camembert-base-mmarcoFR

# PISTE (Legifrance + Judilibre) - a remplir apres inscription sur piste.gouv.fr
PISTE_CLIENT_ID=
PISTE_CLIENT_SECRET=

# Garde-fous applicatifs
MAX_QUESTION_CHARS=2000
RATE_LIMIT_PER_MINUTE=10
# Documentation interactive /docs : 1 en developpement seulement, jamais en production
API_DOCS=1
# Comptes crees par adresse IP sur 24 h (0 = sans limite). A relever pour une inscription en salle (meme wifi).
INSCRIPTIONS_PAR_IP_JOUR=20
# Beta fermee (D121) : 1 = inscription avec un code d'acces seulement (codes crees dans Administration, onglet Beta).
BETA_FERMEE=0

# Origines autorisees pour le front (separees par des virgules)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Pages legales (voir deploy/env.production.exemple pour la liste complete)
# Telephone de l'hebergeur (obligatoire, LCEN art. 1-1 4°) : a demander au support Hostinger
LEGAL_HEBERGEUR_TELEPHONE=
# Mention TVA affichee avec les prix, ex. : TVA non applicable, art. 293 B du CGI
LEGAL_TVA=

# Jurisprudence recente (D113, docs/jurisprudence-recente.md)
# Cle « KeyId » de l'application PISTE de l'editeur, API Judilibre : sans elle, Judilibre n'est jamais appele.
JUDILIBRE_KEY_ID=
# Bac a sable pour un essai : JUDILIBRE_URL=https://sandbox-api.piste.gouv.fr/cassation/judilibre/v1.0
# 0 : ne plus lire les decisions recentes sur le site du Conseil constitutionnel (cache vide la nuit suivante)
# LEXIA_SITE_CONSEIL_CONSTITUTIONNEL=0
