# Copier en .env (jamais commite) et remplir cote serveur uniquement.

# Gemini API Developer (Google AI Studio)
GEMINI_API_KEY=
# Modele de generation principal puis modeles de secours (429/503/delai depasse)
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODELS=gemini-3.8-flash
GEMINI_THINKING_LEVEL=low
LLM_TIMEOUT_SECONDS=30
# Nom du modele d'embeddings (idem)
GEMINI_EMBED_MODEL=gemini-embedding-2

# PISTE (Legifrance + Judilibre) - a remplir apres inscription sur piste.gouv.fr
PISTE_CLIENT_ID=
PISTE_CLIENT_SECRET=

# Recherche : local (index SQLite, python -m ingest.build_index) ou postgres
RETRIEVER=local

# Base de donnees
DATABASE_URL=postgresql://lexia:lexia@localhost:5432/lexia

# Garde-fous applicatifs
MAX_QUESTION_CHARS=2000
RATE_LIMIT_PER_MINUTE=10

# Origines autorisees pour le front (separees par des virgules)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
